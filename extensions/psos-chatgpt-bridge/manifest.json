{
  "manifest_version": 3,
  "name": "PSOS ChatGPT Bridge",
  "version": "0.2.0",
  "description": "Move one bound PSOS manual stage into ChatGPT and return only the new completed assistant response for that stage.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "http://localhost:8766/*"
  ],
  "action": {
    "default_title": "PSOS Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
