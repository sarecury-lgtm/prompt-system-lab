{
  "manifest_version": 3,
  "name": "PSOS ChatGPT Bridge",
  "version": "0.1.0",
  "description": "Move pending PSOS manual prompts into ChatGPT and return the latest response to the local PSOS bridge.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "http://localhost:8766/*"
  ],
  "action": {
    "default_title": "PSOS Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
