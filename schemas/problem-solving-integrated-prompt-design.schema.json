{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PSOS integrated prompt design",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal_ledger", "prompt_build_brief", "final_prompt"],
  "properties": {
    "goal_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_goal",
        "current_goal_hypothesis",
        "fixed_constraints",
        "current_position",
        "selected_route",
        "secondary_route",
        "route_reason",
        "current_step",
        "why_this_step_matters",
        "completion_condition",
        "important_uncertainties"
      ],
      "properties": {
        "parent_goal": {"type": "string", "minLength": 1},
        "current_goal_hypothesis": {"type": "string", "minLength": 1},
        "fixed_constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "current_position": {"type": "string", "minLength": 1},
        "selected_route": {"const": "PROMPT"},
        "secondary_route": {"type": "null"},
        "route_reason": {"type": "string", "minLength": 1},
        "current_step": {"type": "string", "minLength": 1},
        "why_this_step_matters": {"type": "string", "minLength": 1},
        "completion_condition": {"type": "string", "minLength": 1},
        "important_uncertainties": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "prompt_build_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "goal",
        "core_procedure",
        "supporting_inputs",
        "fixed_constraints",
        "output_contract",
        "defaults_and_exceptions",
        "exclusions",
        "upstream_context"
      ],
      "properties": {
        "version": {"type": "integer", "const": 1},
        "goal": {"type": "string", "minLength": 1},
        "core_procedure": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "supporting_inputs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "fixed_constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "output_contract": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "defaults_and_exceptions": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "exclusions": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "upstream_context": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "final_prompt": {
      "type": "string",
      "minLength": 80,
      "maxLength": 100000
    }
  }
}
