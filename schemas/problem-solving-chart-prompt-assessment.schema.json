{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem-solving-chart-prompt-assessment.schema.json",
  "title": "PSOS chart prompt batch comparison assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "ranking",
    "candidates",
    "preferred_candidate_ids",
    "conclusion"
  ],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "ranking": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-H]$"}
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "observation_fidelity",
          "multi_timeframe_synthesis",
          "decision_clarity",
          "plan_quality",
          "calibration",
          "format_cost",
          "critical_failures",
          "finding"
        ],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^[A-H]$"},
          "observation_fidelity": {"type": "integer", "minimum": 1, "maximum": 5},
          "multi_timeframe_synthesis": {"type": "integer", "minimum": 1, "maximum": 5},
          "decision_clarity": {"type": "integer", "minimum": 1, "maximum": 5},
          "plan_quality": {"type": "integer", "minimum": 1, "maximum": 5},
          "calibration": {"type": "integer", "minimum": 1, "maximum": 5},
          "format_cost": {"type": "integer", "minimum": 1, "maximum": 5},
          "critical_failures": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "finding": {"type": "string", "minLength": 1}
        }
      }
    },
    "preferred_candidate_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-H]$"}
    },
    "conclusion": {"type": "string", "minLength": 1}
  }
}
