{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/problem-solving-os-visual-evidence-import.schema.json",
  "title": "PSOS Visual Evidence Import",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "bundle_sha256",
    "subject_label",
    "source_kind",
    "page_url",
    "page_title",
    "captured_at",
    "images"
  ],
  "properties": {
    "version": {"const": 1},
    "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "subject_label": {"type": "string", "minLength": 1, "maxLength": 160},
    "source_kind": {
      "enum": ["seller", "buyer_review", "editorial", "unknown"]
    },
    "page_url": {"type": "string", "format": "uri", "maxLength": 4000},
    "page_title": {"type": "string", "maxLength": 300},
    "captured_at": {"type": "string", "format": "date-time"},
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["src", "alt", "width", "height", "nearby_text", "link_url"],
        "properties": {
          "src": {"type": "string", "format": "uri", "maxLength": 4000},
          "alt": {"type": "string", "maxLength": 300},
          "width": {"type": "integer", "minimum": 1, "maximum": 20000},
          "height": {"type": "integer", "minimum": 1, "maximum": 20000},
          "nearby_text": {"type": "string", "maxLength": 800},
          "link_url": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "format": "uri", "maxLength": 4000}
            ]
          }
        }
      }
    }
  }
}
