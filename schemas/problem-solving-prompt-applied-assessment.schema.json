{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem-solving-prompt-applied-assessment.schema.json",
  "title": "PSOS prompt applied comparison assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "case_id", "candidates", "preferred_candidate_ids", "conclusion"],
  "properties": {
    "version": {"const": 1},
    "case_id": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "requirement_preservation",
          "task_correctness",
          "actionability",
          "calibration",
          "format_cost",
          "critical_failures",
          "finding"
        ],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^[AB]$"},
          "requirement_preservation": {"type": "integer", "minimum": 1, "maximum": 5},
          "task_correctness": {"type": "integer", "minimum": 1, "maximum": 5},
          "actionability": {"type": "integer", "minimum": 1, "maximum": 5},
          "calibration": {"type": "integer", "minimum": 1, "maximum": 5},
          "format_cost": {"type": "integer", "minimum": 1, "maximum": 5},
          "critical_failures": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "finding": {"type": "string", "minLength": 1}
        }
      }
    },
    "preferred_candidate_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[AB]$"}
    },
    "conclusion": {"type": "string", "minLength": 1}
  }
}
