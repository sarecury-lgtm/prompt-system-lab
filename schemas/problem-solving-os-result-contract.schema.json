{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/problem-solving-os-result-contract.schema.json",
  "title": "PSOS Result Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "route",
    "result_type",
    "must_preserve",
    "required_outputs",
    "evidence_requirements",
    "user_review",
    "failure_policy"
  ],
  "properties": {
    "version": {"const": 1},
    "route": {
      "enum": ["DIRECT", "RESEARCH", "REUSE", "PROMPT", "CODE", "PROJECT", "HYBRID"]
    },
    "result_type": {
      "enum": [
        "answer",
        "research",
        "asset_reuse",
        "reusable_prompt",
        "code_change",
        "project_step",
        "hybrid"
      ]
    },
    "must_preserve": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "verification"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "description": {"type": "string", "minLength": 1},
          "verification": {
            "enum": ["text", "evidence", "url", "artifact", "receipt", "visual"]
          }
        }
      }
    },
    "evidence_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_sources", "source_roles", "claim_source_mapping"],
      "properties": {
        "minimum_sources": {"type": "integer", "minimum": 0},
        "source_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "claim_source_mapping": {"type": "boolean"}
      }
    },
    "user_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["needed", "evidence_types"],
      "properties": {
        "needed": {"type": "boolean"},
        "evidence_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["web", "local", "command_output", "provided_context", "image"]
          }
        }
      }
    },
    "failure_policy": {
      "enum": ["partial", "blocked", "no_winner"]
    }
  }
}
