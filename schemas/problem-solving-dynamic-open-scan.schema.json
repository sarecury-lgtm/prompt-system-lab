{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["scan"],
  "properties": {
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terrain_summary",
        "vocabulary",
        "adjacent_possibilities",
        "observations",
        "source_gaps"
      ],
      "properties": {
        "terrain_summary": {"type": "string"},
        "vocabulary": {
          "type": "array",
          "items": {"type": "string"}
        },
        "adjacent_possibilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "relation", "source"],
            "properties": {
              "name": {"type": "string"},
              "relation": {"type": "string"},
              "source": {"type": "string"}
            }
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "finding",
              "source",
              "decision_relevance",
              "evidence_strength"
            ],
            "properties": {
              "finding": {"type": "string"},
              "source": {"type": "string"},
              "decision_relevance": {"type": "string"},
              "evidence_strength": {
                "type": "string",
                "enum": ["direct", "indirect", "unknown"]
              }
            }
          }
        },
        "source_gaps": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
