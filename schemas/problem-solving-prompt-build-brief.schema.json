{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PSOS Prompt Build Brief patch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "goal",
    "core_procedure",
    "supporting_inputs",
    "fixed_constraints",
    "output_contract",
    "defaults_and_exceptions",
    "exclusions",
    "upstream_context"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "core_procedure": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supporting_inputs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixed_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_contract": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "defaults_and_exceptions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclusions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "upstream_context": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
