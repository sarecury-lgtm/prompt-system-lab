{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem-solving-adaptive-product-decision.schema.json",
  "title": "PSOS Adaptive Product Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision"],
  "properties": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "winner_id",
        "ranked",
        "summary",
        "no_winner_reason",
        "decision_change_conditions"
      ],
      "properties": {
        "winner_id": {"type": ["string", "null"]},
        "ranked": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["product_id", "rank", "reasons", "risks"],
            "properties": {
              "product_id": {"type": "string", "minLength": 1},
              "rank": {"type": "integer", "minimum": 1, "maximum": 5},
              "reasons": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {"type": "string", "minLength": 1}
              },
              "risks": {
                "type": "array",
                "maxItems": 5,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "summary": {"type": "string", "minLength": 1},
        "no_winner_reason": {"type": ["string", "null"]},
        "decision_change_conditions": {
          "type": "array",
          "maxItems": 6,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
